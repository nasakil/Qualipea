{
  "expo": {
    "name": "QualiPea",
    "slug": "qualipea",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#123d2b",
    "android": {
      "package": "com.qualipea.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#123d2b"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.qualipea.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QualiPea to access your camera to scan peanut kernels."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/OpenRunde-Regular.otf",
            "./assets/fonts/OpenRunde-Medium.otf",
            "./assets/fonts/OpenRunde-Semibold.otf",
            "./assets/fonts/OpenRunde-Bold.otf"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afee67d0-954e-43c9-b5bb-32f2cf857900"
      }
    },
    "owner": "katto"
  }
}
